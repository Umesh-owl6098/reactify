# Dependencies and package-manager cache
node_modules/
.pnpm-store/
.pnpm-debug.log*
.corepack-shims/

# Local databases and generated state
*.db
*.db-shm
*.db-wal

# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Build and test output
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
apps/web/scripts/*-report.json
scripts/*-report.json

# Runtime storage and generated artifacts (repo-root only)
/storage/
apps/api/storage/
apps/api/test-fixtures/
tmp/
temp/
.tmp/

# Archives and screenshots generated during export/recovery
*.zip
apps/api/storage/**/*.png
storage/**/*.png

# End-to-end session state and Playwright output
apps/web/e2e/.auth/
apps/web/playwright-report/
apps/web/test-results/
playwright-report/
test-results/

# Legacy runtime upload paths
storage/images/*
!storage/images/.gitkeep
storage/comparisons/*
!storage/comparisons/.gitkeep

# OS and editor files
.DS_Store
.vscode/
.idea/
