# API server
PORT=3001
NODE_ENV=development

# Image upload
IMAGE_MAX_BYTES=10485760
IMAGE_STORAGE_DIR=storage/images
ALLOWED_ORIGINS=http://localhost:5173

# AI provider (mock | anthropic)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.2

# Future foundation tasks (not required yet)
