# API server
PORT=3001
NODE_ENV=development

# Image upload and object storage
IMAGE_MAX_BYTES=10485760
IMAGE_STORAGE_DIR=storage/images
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
# Production S3-compatible storage (Railway bucket)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://storage.railway.app
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Server binding and proxy
HOST=127.0.0.1
TRUST_PROXY=false
SESSION_COOKIE_SAME_SITE=lax
# Authentication
SESSION_COOKIE_NAME=reactify_session
SESSION_TTL_HOURS=168
SESSION_TOKEN_BYTES=32
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_PARALLELISM=1
AUTH_ALLOWED_ORIGINS=http://localhost:5174
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
AUTH_ALLOWED_ORIGINS=http://localhost:5174

# AI provider (mock | anthropic | openai)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_RETRIES=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_TIMEOUT_MS=180000
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.2
# Optional test-only stage failure injection (mock provider). Leave unset for normal development.
# MOCK_AI_FAILURE_STAGE=design_analysis

# Database (PostgreSQL)
DATABASE_URL=postgresql://reactify:reactify_dev@localhost:5434/reactify
DATABASE_CONNECTION_LIMIT=10
DATABASE_QUERY_TIMEOUT_MS=30000

# Export limits
MAX_EXPORT_FILES=200
MAX_EXPORT_FILE_BYTES=524288
MAX_EXPORT_TOTAL_BYTES=5242880
MAX_EXPORT_ZIP_BYTES=8388608
MAX_EDIT_INSTRUCTION_LENGTH=2000
MIN_EDIT_INSTRUCTION_LENGTH=3
MAX_EDIT_CLARIFICATION_ROUNDS=3
HIGH_RISK_FILE_THRESHOLD=5
MAX_EDIT_SCOPE_RATIO=0.5

# Visual comparison
VISUAL_COMPARISON_STORAGE_DIR=storage/comparisons
MAX_PREVIEW_SCREENSHOT_BYTES=5242880
MAX_PREVIEW_SCREENSHOT_DIMENSION=4096
MIN_PREVIEW_SCREENSHOT_DIMENSION=120
VISUAL_COMPARISON_NOISE_THRESHOLD=24
VISUAL_COMPARISON_REGION_MERGE_DISTANCE=24
VISUAL_COMPARISON_MAX_REGIONS=12
VISUAL_COMPARISON_MIN_REGION_SIZE=16
VISUAL_SIMILARITY_ACCEPTABLE_THRESHOLD=92
VISUAL_CORRECTION_RECOMMEND_THRESHOLD=85
VISUAL_CORRECTION_MIN_IMPROVEMENT=2
MAX_VISUAL_CORRECTION_ATTEMPTS=3

# Background job queue
JOB_WORKER_POLL_INTERVAL_MS=1000
JOB_LOCK_TTL_MS=120000
JOB_HEARTBEAT_INTERVAL_MS=15000
JOB_SHUTDOWN_GRACE_MS=30000
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_EXPORT_MAX_ATTEMPTS=2
JOB_RETRY_BASE_DELAY_MS=5000
JOB_RETRY_MAX_DELAY_MS=60000
JOB_BATCH_SIZE=5
WORKER_CONCURRENCY=2
JOB_INLINE_EXECUTION=false
JOB_STALE_RECOVERY_INTERVAL_MS=60000
JOB_STALE_GENERATION_THRESHOLD_MS=120000
JOB_MISSING_GRACE_MS=60000

# AI usage limits and pricing (USD). Empty budget/token fields mean unlimited.
AI_DEFAULT_MONTHLY_BUDGET_USD=
AI_DEFAULT_MONTHLY_TOKEN_LIMIT=
AI_DEFAULT_MAX_OPERATION_COST_USD=5
AI_DEFAULT_MAX_OPERATIONS_PER_DAY=
AI_USAGE_RESERVATION_TTL_MINUTES=120
AI_BUDGET_WARNING_PERCENT=80
AI_COST_CONFIRMATION_THRESHOLD_USD=1
AI_PRICING_0_PROVIDER=mock
AI_PRICING_0_MODEL=claude-3-5-sonnet-20241022
AI_PRICING_0_INPUT_PER_MILLION_USD=3
AI_PRICING_0_OUTPUT_PER_MILLION_USD=15
AI_PRICING_1_PROVIDER=anthropic
AI_PRICING_1_MODEL=claude-3-5-sonnet-20241022
AI_PRICING_1_INPUT_PER_MILLION_USD=3
AI_PRICING_1_OUTPUT_PER_MILLION_USD=15
AI_PRICING_2_PROVIDER=openai
AI_PRICING_2_MODEL=gpt-4o
AI_PRICING_2_INPUT_PER_MILLION_USD=2.5
AI_PRICING_2_OUTPUT_PER_MILLION_USD=10
AI_PRICING_ALLOW_FALLBACK=false
AI_PRICING_FALLBACK_INPUT_PER_MILLION_USD=
AI_PRICING_FALLBACK_OUTPUT_PER_MILLION_USD=
