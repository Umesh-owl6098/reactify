{
  "name": "@reactify/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:api": "tsx watch --clear-screen=false --ignore '**/*.test.ts' --ignore '**/*.integration.test.ts' --env-file=.env src/index.ts",
    "dev:worker": "tsx watch --clear-screen=false --ignore '**/*.test.ts' --ignore '**/*.integration.test.ts' --env-file=.env src/worker.ts",
    "start": "node dist/index.js",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "../../node_modules/.bin/eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.3.1",
    "@reactify/generation-contracts": "workspace:*",
    "@reactify/shared": "workspace:*",
    "@reactify/test-utils": "workspace:*",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "fastify": "^5.2.1",
    "gray-matter": "^4.0.3",
    "openai": "^6.49.0",
    "pixelmatch": "^7.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.12.0",
    "@types/pixelmatch": "^5.2.6",
    "jszip": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
