# VITE_API_URL=http://localhost:3001
# Production example:
# VITE_API_URL=https://reactify-api-production.up.railway.app

# Optional: override Sandpack bundler for local/self-hosted development
# VITE_SANDPACK_BUNDLER_URL=http://127.0.0.1:4587
